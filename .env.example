# OpenRouter key for live upstream calls; leave empty to use the offline mock upstream
OPENROUTER_API_KEY=
# Optional comma-separated model list, tried in order
OPENROUTER_MODELS=
# Secret used to derive per-session PII tokens (HMAC); random per process when empty
AGENT_PROXY_SECRET=
# Optional key that signs each audit record (HMAC) so the chain cannot be recomputed without it
AGENT_PROXY_AUDIT_KEY=
